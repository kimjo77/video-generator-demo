{
  "name": "frame-video-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/check-ports.mjs 3000 8000 && concurrently --kill-others --names api,web --prefix-colors yellow,cyan \"npm run dev --workspace=@frame/server\" \"npm run dev --workspace=@frame/web\"",
    "dev:web": "npm run dev --workspace=@frame/web",
    "dev:server": "npm run dev --workspace=@frame/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "build": "npm run build:shared && npm run build --workspace=@frame/server && npm run build --workspace=@frame/web",
    "start:server": "npm run start --workspace=@frame/server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:shared": "npm run build --workspace=@frame/shared",
    "predev": "npm run build:shared",
    "predev:web": "npm run build:shared",
    "predev:server": "npm run build:shared"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true
  }
}
