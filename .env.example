# Backend only. Copy this file to .env in the repository root.
# Create this key in an AI Studio project on the free tier. Quotas vary by account.
GEMINI_API_KEY=
PIXABAY_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_SPEECH_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE=Kore
# Optional: use your own binaries instead of the packaged ones.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# FONT_PATH=/path/to/DejaVuSans.ttf

# Required for custom fonts whose filename is not recognized (DejaVu Sans or Arial).
# FONT_FAMILY=DejaVu Sans
